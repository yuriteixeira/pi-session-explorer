{
  "name": "pi-session-viewer",
  "version": "0.1.0",
  "description": "Browse Pi session records and open them in your editor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuriteixeira/pi-session-viewer.git"
  },
  "homepage": "https://github.com/yuriteixeira/pi-session-viewer#readme",
  "bugs": "https://github.com/yuriteixeira/pi-session-viewer/issues",
